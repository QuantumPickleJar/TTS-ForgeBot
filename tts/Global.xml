          <Button id="BridgeHudAction17" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction18" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction19" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction20" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction21" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction22" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction23" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudAction24" active="false" onClick="BridgeHudAction" text="" fontSize="13" minHeight="26" preferredHeight="26" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
        </VerticalLayout>
      </VerticalScrollView>
    </VerticalLayout>

    <!-- Large graveyard-origin choice sets stay in a decision-scoped child panel. -->
    <VerticalLayout id="BridgeHudGraveyardPanel" active="false" minHeight="160" preferredHeight="190" flexibleHeight="0" spacing="4" padding="7 7 7 7" childForceExpandHeight="false" childForceExpandWidth="true" color="#111827F2">
      <HorizontalLayout minHeight="24" preferredHeight="24" flexibleHeight="0" spacing="6" childForceExpandWidth="false" childForceExpandHeight="true">
        <Text text="GRAVEYARD ACTIONS" minWidth="220" preferredWidth="220" flexibleWidth="0" fontSize="12" color="#F8FAFC" alignment="MiddleLeft" />
        <Button id="BridgeHudGraveyardPrev" active="false" onClick="BridgeHudGraveyardPage" text="PREV" tooltip="Show the previous page of exact Forge graveyard actions." minWidth="65" preferredWidth="65" flexibleWidth="0" fontSize="10" color="#334155EE" textColor="#FFFFFF" />
        <Button id="BridgeHudGraveyardNext" active="false" onClick="BridgeHudGraveyardPage" text="NEXT" tooltip="Show the next page of exact Forge graveyard actions." minWidth="65" preferredWidth="65" flexibleWidth="0" fontSize="10" color="#334155EE" textColor="#FFFFFF" />
        <Button id="BridgeHudGraveyardClose" active="false" onClick="BridgeHudGraveyardClose" text="CLOSE" tooltip="Close the graveyard action list without changing Forge state." minWidth="80" preferredWidth="80" flexibleWidth="0" fontSize="10" color="#334155EE" textColor="#FFFFFF" />
      </HorizontalLayout>
      <VerticalScrollView minHeight="116" preferredHeight="116" flexibleHeight="0" verticalScrollbarVisibility="AutoHideAndExpandViewport">
        <VerticalLayout spacing="2" childForceExpandHeight="false" childForceExpandWidth="true">
          <Button id="BridgeHudGraveyardAction1" active="false" onClick="BridgeHudGraveyardAction" text="" fontSize="12" minHeight="25" preferredHeight="25" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudGraveyardAction2" active="false" onClick="BridgeHudGraveyardAction" text="" fontSize="12" minHeight="25" preferredHeight="25" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
          <Button id="BridgeHudGraveyardAction3" active="false" onClick="BridgeHudGraveyardAction" text="" fontSize="12" minHeight="25" preferredHeight="25" flexibleHeight="0" color="#26364ACC" textColor="#F8FAFC" />
