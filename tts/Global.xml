        </VerticalLayout>
      </VerticalScrollView>
      <Text id="BridgeHudGraveyardOverflow" text="" minHeight="16" preferredHeight="16" flexibleHeight="0" fontSize="10" color="#FCA5A5" alignment="MiddleLeft" />
    </VerticalLayout>

    <!-- Creature-type choices are kept out of the bounded generic action tray. -->
    <VerticalLayout id="BridgeHudCreatureTypePanel" active="false" minHeight="92" preferredHeight="92" flexibleHeight="0" spacing="5" padding="8 8 8 8" childForceExpandHeight="false" childForceExpandWidth="true" color="#0D1825EE">
      <Text id="BridgeHudCreatureTypePrompt" text="CHOOSE CREATURE TYPE" minHeight="18" preferredHeight="18" flexibleHeight="0" fontSize="12" color="#F8FAFC" alignment="MiddleLeft" />
      <!-- TTS constructs Dropdown options during XML load; an empty option set
           dereferences a null internal selection before Lua can populate it. -->
      <Dropdown id="BridgeHudCreatureTypeDropdown" options="Choose" value="Choose" onValueChanged="BridgeHudCreatureTypeChanged" minHeight="30" preferredHeight="30" flexibleHeight="0" fontSize="13" color="#26364AEE" textColor="#F8FAFC" />
      <HorizontalLayout minHeight="28" preferredHeight="28" flexibleHeight="0" spacing="6" childForceExpandWidth="false" childForceExpandHeight="true">
        <Button id="BridgeHudCreatureTypeConfirm" active="false" onClick="BridgeHudCreatureTypeConfirm" text="CONFIRM TYPE" tooltip="Submit the selected Forge creature type. Changing the dropdown alone does not submit." minWidth="170" preferredWidth="170" flexibleWidth="0" fontSize="12" color="#166534EE" textColor="#FFFFFF" />
        <Button id="BridgeHudCreatureTypeCancel" active="true" onClick="BridgeHudCreatureTypeCancel" text="CANCEL" tooltip="Clear the local creature-type draft without submitting a Forge choice." minWidth="120" preferredWidth="120" flexibleWidth="0" fontSize="12" color="#334155EE" textColor="#FFFFFF" />
        <Text id="BridgeHudCreatureTypeStatus" text="" minWidth="340" preferredWidth="340" flexibleWidth="0" fontSize="10" color="#D6DFEA" alignment="MiddleLeft" />
      </HorizontalLayout>
    </VerticalLayout>

    <!-- Host/Admin developer drawer. -->
    <VerticalLayout id="BridgeHudDevRoot" active="false" visibility="Host|Admin" minHeight="230" preferredHeight="230" flexibleHeight="0" spacing="5" padding="7 7 7 7" childForceExpandHeight="false" childForceExpandWidth="true" color="#070C13F0">
      <HorizontalLayout minHeight="29" preferredHeight="29" flexibleHeight="0" spacing="5" childForceExpandWidth="false" childForceExpandHeight="true">
        <Button id="BridgeHudMode" onClick="BridgeHudMode" text="SMART" tooltip="Cycle SMART, YIELD, and MANUAL priority behavior." minWidth="105" preferredWidth="105" flexibleWidth="0" fontSize="11" color="#1E293BCC" textColor="#CBD5E1" />
        <Button id="BridgeHudFast" onClick="BridgeHudFast" text="FAST: OFF" tooltip="Fast Playtest shortens cosmetic movement and UI delays. It never skips Forge decisions or rules events." minWidth="105" preferredWidth="105" flexibleWidth="0" fontSize="11" color="#81a8e6cc" textColor="#CBD5E1" />
        <Button id="BridgeHudMana" onClick="BridgeHudMana" text="MANA: AUTO" tooltip="AUTO lets Forge choose payment sources. Manual source choices require launching ForgeBot with -ManualMana." minWidth="135" preferredWidth="135" flexibleWidth="0" fontSize="11" color="#9aadcdcc" textColor="#CBD5E1" />
        <Button id="BridgeHudLog" onClick="BridgeHudLog" text="LOG: ON" tooltip="Show or hide the latest player-facing Forge event message." minWidth="95" preferredWidth="95" flexibleWidth="0" fontSize="11" color="#1E293BCC" textColor="#CBD5E1" />
      </HorizontalLayout>
      <Text id="BridgeHudHelp" text="SMART: Forge auto-advances only when it has no meaningful human choice." minHeight="18" preferredHeight="18" flexibleHeight="0" fontSize="11" color="#AAB7C6" alignment="MiddleLeft" />
      <HorizontalLayout id="BridgeHudReportActions" minHeight="28" preferredHeight="28" flexibleHeight="0" spacing="5" childForceExpandWidth="false" childForceExpandHeight="true">
        <Button id="BridgeHudReportOpen" onClick="BridgeHudReportOpen" text="REPORT BUG" tooltip="Capture a local diagnostic ZIP without changing the Forge match." minWidth="135" preferredWidth="135" flexibleWidth="0" fontSize="11" color="#7F1D1DCC" textColor="#FFFFFF" />
        <Button id="BridgeHudReportCategoryPrevious" active="false" onClick="BridgeHudReportCategoryPrevious" text="&lt;" tooltip="Previous diagnostic category." minWidth="28" preferredWidth="28" flexibleWidth="0" fontSize="13" color="#1E293BCC" textColor="#CBD5E1" />
        <Button id="BridgeHudReportCategory" active="false" onClick="BridgeHudReportCategory" text="Gameplay sync" tooltip="Cycle the diagnostic category." minWidth="145" preferredWidth="145" flexibleWidth="0" fontSize="10" color="#586880cc" textColor="#CBD5E1" />
      </HorizontalLayout>
      <VerticalLayout id="BridgeHudReportPanel" active="false" minHeight="93" preferredHeight="93" flexibleHeight="0" spacing="4" childForceExpandHeight="false" childForceExpandWidth="true" color="#0D1825EE">
        <InputField id="BridgeHudReportSummary" text="" placeholder="Short description (optional)" characterLimit="240" minHeight="24" preferredHeight="24" flexibleHeight="0" fontSize="11" color="#172235" textColor="#F8FAFC" />
        <Dropdown id="BridgeHudReportCategoryDropdown" options="Gameplay sync|Combat|Card movement|Presentation/UI|Decision/prompt|Mana/payment|Performance / Freeze|Crash/error|Other" value="Gameplay sync" onValueChanged="BridgeHudReportCategoryChanged" minWidth="650" preferredWidth="650" flexibleWidth="0" minHeight="27" preferredHeight="27" flexibleHeight="0" fontSize="10" color="#1E293BCC" textColor="#CBD5E1" />
        <HorizontalLayout minHeight="27" preferredHeight="27" flexibleHeight="0" spacing="5" childForceExpandWidth="false" childForceExpandHeight="true">
          <Button id="BridgeHudReportCapture" onClick="BridgeHudReportCapture" text="CAPTURE" minWidth="105" preferredWidth="105" flexibleWidth="0" fontSize="11" color="#166534DD" textColor="#FFFFFF" />
          <Button id="BridgeHudReportCancel" onClick="BridgeHudReportCancel" text="CANCEL" minWidth="90" preferredWidth="90" flexibleWidth="0" fontSize="11" color="#334155DD" textColor="#F8FAFC" />
          <Text id="BridgeHudReportStatus" text="" minWidth="350" preferredWidth="350" flexibleWidth="0" fontSize="10" color="#AAB7C6" alignment="MiddleLeft" />
        </HorizontalLayout>
      </VerticalLayout>
      <Text id="BridgeHudDevDiagnostic" text="" minHeight="18" preferredHeight="18" flexibleHeight="0" fontSize="10" color="#8291A4" alignment="MiddleLeft" />
    </VerticalLayout>

    <HorizontalLayout minHeight="22" preferredHeight="22" flexibleHeight="0" spacing="8" childForceExpandWidth="false" childForceExpandHeight="true">
      <Text id="BridgeHudStack" text="" minWidth="100" preferredWidth="100" flexibleWidth="0" fontSize="11" color="#9FB1C6" alignment="MiddleLeft" />
      <Text id="BridgeHudFooter" text="HUD XML V3 LOADED" minWidth="580" preferredWidth="580" flexibleWidth="0" fontSize="11" color="#98A6B8" alignment="MiddleRight" />
    </HorizontalLayout>

  </VerticalLayout>
</Panel>
