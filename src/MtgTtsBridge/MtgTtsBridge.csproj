<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\MtgTtsBridge.Contracts\MtgTtsBridge.Contracts.csproj" />
    <!-- The generated TTS artifact is part of the runtime build contract.  It
         is embedded so compatibility checks never consult a developer checkout. -->
    <EmbeddedResource Include="..\..\tts\Global.lua" LogicalName="MtgTtsBridge.GeneratedGlobalLua" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".dev\**\*.cs" />
    <EmbeddedResource Remove=".dev\**\*" />
    <None Remove=".dev\**\*" />
  </ItemGroup>

</Project>
