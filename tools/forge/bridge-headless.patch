+import forge.game.event.GameEventPlayerLivesChanged;
+import forge.game.event.GameEventPlayerPoisoned;
+import forge.game.event.GameEventPlayerStatsChanged;
+import forge.game.event.GameEventShuffle;
+import forge.game.event.GameEventSnapshotRestored;
+import forge.game.event.GameEventTurnBegan;
+import forge.game.keyword.KeywordInterface;
+import forge.game.player.Player;
+import forge.game.zone.ZoneType;
+import forge.util.ThreadUtil;
+
+import java.util.IdentityHashMap;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.ConcurrentModificationException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Emits bridge-internal authoritative snapshots without changing game behavior.
+ * The sentinel lets the child-process adapter remove these records before the
+ * human TUI parser sees them.
+ */
+final class BridgeStateFeed {
+    private static final class DuplicateCardIdentityException extends RuntimeException {
+        DuplicateCardIdentityException(final Card card, final String zone) {
+            super("CardInstanceId " + card.getId() + " appeared more than once while emitting " + zone);
+        }
+    }
+    static final String SENTINEL = "@@FORGE_BRIDGE_STATE@@";
+    private static final List<ZoneType> PLAYER_ZONES = List.of(
+            ZoneType.Library,
+            ZoneType.Hand,
+            ZoneType.Battlefield,
+            ZoneType.Graveyard,
+            ZoneType.Exile,
+            ZoneType.Command);
+
+    private final Game game;
+    private final Map<Player, String> seats = new IdentityHashMap<>();
+    private final AtomicBoolean snapshotScheduled = new AtomicBoolean();
+    private final AtomicLong mutationGeneration = new AtomicLong();
+    private final AtomicReference<String> latestReason = new AtomicReference<>("initial");
+    private final AtomicBoolean terminalSnapshotEmitted = new AtomicBoolean();
+    private long sequence;
+
+    BridgeStateFeed(final Game game) {
+        this.game = game;
+        int index = 1;
+        for (Player player : game.getPlayers()) {
+            seats.put(player, "forge-player-" + index++);
+        }
+    }
+
+    @Subscribe
+    public void receive(final GameEvent event) {
+        if (event instanceof GameEventGameOutcome) {
+            emitTerminalSnapshot();
+            return;
+        }
+        if (event instanceof GameEventBlockersDeclared) {
+            // GameEventBlockersDeclared uses the attacker itself as a sentinel
+            // value for an unblocked attacker. Its event payload is therefore
+            // not an exact blocker identity. The following complete combat
+            // snapshot is the sole authoritative source for presentation.
+            scheduleSnapshot(event.getClass().getSimpleName());
+            return;
+        }
+        if (event instanceof GameEventCardChangeZone
+                || event instanceof GameEventCardTapped
+                || event instanceof GameEventCardCounters
+                || event instanceof GameEventCardStatsChanged
+                || event instanceof GameEventPlayerLivesChanged
+                || event instanceof GameEventPlayerStatsChanged
+                || event instanceof GameEventPlayerCounters
+                || event instanceof GameEventPlayerPoisoned
+                || event instanceof GameEventManaPool
+                || event instanceof GameEventShuffle
+                || event instanceof GameEventGameStarted
+                || event instanceof GameEventMulligan
+                || event instanceof GameEventTurnBegan
+                || event instanceof GameEventSnapshotRestored) {
+            scheduleSnapshot(event.getClass().getSimpleName());
+        }
+    }
+
+    /**
+     * Game events fire while Forge is mutating zone collections. Reading all
+     * zones re-entrantly from the event bus caused ConcurrentModificationException
+     * during opening-hand setup. Coalesce events and snapshot shortly after the
+     * mutation batch on the bridge's read-only observer path instead.
+     */
+    private void scheduleSnapshot(final String reason) {
+        final long generation = mutationGeneration.incrementAndGet();
+        latestReason.set(reason);
+        trace("event=" + reason + " generation=" + generation + " scheduled=" + snapshotScheduled.get());
+        if (!snapshotScheduled.compareAndSet(false, true)) {
+            return;
+        }
+        ThreadUtil.delay(25, this::emitWhenStable);
+    }
+
+    void emitTerminalSnapshot() {
+        if (!game.isGameOver() || !terminalSnapshotEmitted.compareAndSet(false, true)) return;
+        emitSnapshot("game_ended", mutationGeneration.get());
+    }
+
+    /**
+     * A batch can contain zone movement followed by static characteristic
+     * recalculation. Never clear the pending flag until the generation that
+     * was emitted is still current; otherwise the final static state can be
+     * lost until a later unrelated game event happens to cause a snapshot.
+     */
+    private void emitWhenStable() {
+        final long generation = mutationGeneration.get();
+        final String reason = latestReason.get();
+        try {
+            emitSnapshot(reason, generation);
+            if (mutationGeneration.get() != generation) {
+                ThreadUtil.delay(25, this::emitWhenStable);
+                return;
+            }
+            snapshotScheduled.set(false);
+            // Close the race where an event arrived after the equality check
+            // but before clearing the scheduled flag.
+            if (mutationGeneration.get() != generation) {
+                scheduleSnapshot(latestReason.get());
+            }
+        } catch (ConcurrentModificationException ignored) {
+            ThreadUtil.delay(25, this::emitWhenStable);
+        } catch (DuplicateCardIdentityException duplicate) {
+            // Opening-hand/mulligan setup can transiently expose the same Card
+            // reference twice while Forge is moving it between zones. Never
+            // publish that impossible snapshot; retry after the mutation batch
+            // settles. The bridge retains a loud duplicate check for any
+            // duplicate that still escapes this producer barrier.
+            trace("snapshot deferred: " + duplicate.getMessage());
+            ThreadUtil.delay(25, this::emitWhenStable);
+        } catch (RuntimeException exception) {
+            // A diagnostics feed must never change or terminate Forge gameplay.
+            snapshotScheduled.set(false);
+            System.err.println("Forge bridge state snapshot skipped: " + exception.getClass().getSimpleName());
+        }
+    }
+
+    private void emitSnapshot(final String reason, final long generation) {
+        final StringBuilder json = new StringBuilder(32768);
+        final Set<Integer> emittedCardIds = new HashSet<>();
+        json.append('{');
+        property(json, "version", 1).append(',');
+        property(json, "type", "snapshot").append(',');
+        property(json, "sequence", ++sequence).append(',');
+        property(json, "reason", reason).append(',');
+        property(json, "mutationGeneration", generation).append(',');
+        property(json, "monarchSeatId", seatOf(game.getMonarch())).append(',');
+        json.append("\"players\":[");
+
+        boolean firstPlayer = true;
+        for (Player player : game.getPlayers()) {
+            if (!firstPlayer) json.append(',');
+            firstPlayer = false;
+            appendPlayer(json, player, emittedCardIds);
+        }
+
+        json.append("],\"stack\":[");
+        boolean firstCard = true;
+        int position = 0;
+        for (Card card : game.getStackZone().getCards()) {
+            if (!firstCard) json.append(',');
+            firstCard = false;
+            appendCard(json, card, "stack", position++, emittedCardIds);
+        }
+        json.append("],\"relationships\":");
+        appendRelationships(json);
+        json.append(",\"combat\":");
+        appendCombat(json);
+        if (game.isGameOver()) {
+            json.append(",\"gameEnded\":");
+            appendGameEnded(json);
+        }
+        json.append('}');
+
+        synchronized (System.out) {
+            System.out.println(SENTINEL + json);
+        }
+        trace("snapshot sequence=" + sequence + " generation=" + generation + " reason=" + reason
+                + " battlefield=" + battlefieldSummary());
+    }
+
+    private void appendPlayer(final StringBuilder json, final Player player, final Set<Integer> emittedCardIds) {
+        json.append('{');
+        property(json, "seatId", seatOf(player)).append(',');
+        property(json, "forgePlayerId", player.getId()).append(',');
+        property(json, "displayName", player.getName()).append(',');
+        property(json, "life", player.getLife()).append(',');
+        property(json, "poison", player.getPoisonCounters()).append(',');
+        property(json, "speed", player.getSpeed()).append(',');
+        json.append("\"designations\":[");
+        appendDesignations(json, player);
+        json.append("],");
+        json.append("\"counters\":");
+        appendCounters(json, player.getCounters());
+        json.append(",\"manaPool\":");
+        appendManaPool(json, player);
+        json.append(",\"zones\":[");
+
+        boolean firstZone = true;
+        for (ZoneType zoneType : PLAYER_ZONES) {
+            if (!firstZone) json.append(',');
+            firstZone = false;
+            json.append('{');
+            property(json, "name", zoneName(zoneType)).append(',');
+            json.append("\"cards\":[");
+            boolean firstCard = true;
+            int position = 0;
+            for (Card card : player.getZone(zoneType).getCards(false)) {
+                // Forge owns PreparedSpell copies in exile. They are legal
+                // virtual/UI-only spell objects, not physical TTS cards; their
+                // cast action carries an exact relation to the source instead.
+                if (card.getCurrentStateName() == CardStateName.PreparedSpell) continue;
+                if (!firstCard) json.append(',');
+                firstCard = false;
+                appendCard(json, card, zoneName(zoneType), position++, emittedCardIds);
+            }
+            json.append("]}");
+        }
+        json.append("]}");
+    }
+
+    private void appendCard(final StringBuilder json, final Card card, final String zone, final int position, final Set<Integer> emittedCardIds) {
+        if (!emittedCardIds.add(card.getId())) {
+            throw new DuplicateCardIdentityException(card, zone);
+        }
+        final String canonicalName = card.getPaperCard() == null ? card.getName() : card.getPaperCard().getName();
+        json.append('{');
+        property(json, "forgeCardId", card.getId()).append(',');
+        property(json, "cardName", canonicalName).append(',');
+        property(json, "currentCardName", card.getName()).append(',');
+        property(json, "zone", zone).append(',');
+        property(json, "zonePosition", position).append(',');
+        property(json, "ownerSeatId", seatOf(card.getOwner())).append(',');
+        property(json, "controllerSeatId", seatOf(card.getController())).append(',');
+        property(json, "tapped", card.isTapped()).append(',');
+        property(json, "faceDown", card.isFaceDown()).append(',');
+        property(json, "phasedOut", card.isPhasedOut()).append(',');
+        property(json, "netPower", card.isCreature() ? card.getNetPower() : 0).append(',');
+        property(json, "netToughness", card.isCreature() ? card.getNetToughness() : 0).append(',');
+        property(json, "currentPower", card.isCreature() ? card.getNetPower() : 0).append(',');
+        property(json, "currentToughness", card.isCreature() ? card.getNetToughness() : 0).append(',');
+        json.append("\"currentTypes\":");
+        appendCurrentTypes(json, card.getType());
+        json.append(',');
+        json.append("\"cardDesignations\":[");
+        if (card.isPrepared()) string(json, "prepared");
+        if (card.isPrototyped()) {
+            if (card.isPrepared()) json.append(',');
+            string(json, "prototyped");
+        }
+        json.append("],");
+        json.append("\"counters\":");
+        appendCounters(json, card.getCounters());
+        json.append(",\"keywords\":[");
+
+        final Set<String> keywords = new LinkedHashSet<>();
+        for (KeywordInterface keyword : card.getKeywords()) {
+            final String name = keyword.getKeyword().toString();
+            if (!name.isEmpty()) keywords.add(name);
+        }
+        boolean firstKeyword = true;
+        for (String keyword : keywords) {
+            if (!firstKeyword) json.append(',');
+            firstKeyword = false;
+            string(json, keyword);
+        }
+        json.append("]}");
+    }
+
+    /** Emits only Forge's native attachment/pair pointers; geometry and names
+     * are never consulted. */
+    private void appendRelationships(final StringBuilder json) {
+        final Map<Integer, Card> cards = new java.util.TreeMap<>();
+        for (Player player : game.getPlayers()) {
+            for (ZoneType zone : PLAYER_ZONES) {
+                player.getZone(zone).getCards(false).forEach(card -> cards.putIfAbsent(card.getId(), card));
+            }
+            // Mutated components live in Forge's Merged zone rather than on
+            // the battlefield. They remain part of the authoritative graph.
+            player.getZone(ZoneType.Merged).getCards(false)
+                    .forEach(card -> cards.putIfAbsent(card.getId(), card));
+        }
+        game.getStackZone().getCards().forEach(card -> cards.putIfAbsent(card.getId(), card));
+        final Set<String> emitted = new LinkedHashSet<>();
+        json.append('[');
+        boolean first = true;
+        for (Card source : cards.values()) {
+            if (source.isAttachedToEntity()) {
+                final GameEntity target = source.getEntityAttachedTo();
+                final String kind = source.isAura() ? "aura_attachment"
+                        : source.isEquipment() ? "equipment_attachment"
+                        : source.isFortification() ? "fortification_attachment" : "attachment";
+                final String id = "attachment:" + source.getId() + ":" + (target instanceof Card card ? card.getId() : "player");
+                if (emitted.add(id)) {
+                    if (!first) json.append(',');
+                    first = false;
+                    json.append('{');
+                    property(json, "relationshipId", id).append(',');
+                    property(json, "kind", kind).append(',');
+                    property(json, "sourceForgeObjectId", source.getId()).append(',');
+                    if (target instanceof Card card) property(json, "targetForgeObjectId", card.getId()).append(',');
+                    else if (target instanceof Player player) property(json, "targetSeatId", seatOf(player)).append(',');
+                    json.append('}');
+                }
+            }
+            final Card paired = source.getPairedWith();
+            if (paired != null && source.getId() < paired.getId()) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + paired.getId(),
+                        "paired", source, paired, null, null, null, first);
+            }
+
+            final Card haunting = source.getHaunting();
+            if (haunting != null) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + haunting.getId(),
+                        "haunt", source, haunting, null, "haunting", null, first);
+            }
+
+            int order = 0;
+            for (Card encoded : source.getEncodedCards()) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + encoded.getId(),
+                        "cipher", source, encoded, "cipher:" + source.getId(), "encoded", order++, first);
+            }
+
+            order = 0;
+            for (Object remembered : source.getRemembered()) {
+                if (!(remembered instanceof Card card)) continue;
+                first = appendRelationship(json, emitted, source.getId() + ":" + card.getId(),
+                        "remembered", source, card, "remembered:" + source.getId(),
+                        source.hasKeyword("Champion") ? "championed" : "remembered", order++, first);
+            }
+
+            final Card exiledWith = source.getExiledWith();
+            if (exiledWith != null) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + exiledWith.getId(),
+                        "linked_exile", source, exiledWith, "linked-exile:" + exiledWith.getId(), "exiled", null, first);
+            }
+
+            order = 0;
+            for (Card imprinted : source.getImprintedCards()) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + imprinted.getId(),
+                        "imprinted", source, imprinted, "imprinted:" + source.getId(), "imprinted", order++, first);
+            }
+
+            order = 0;
+            if (source.hasMergedCard()) {
+                for (Card component : source.getMergedCards()) {
+                    first = appendRelationship(json, emitted, source.getId() + ":" + component.getId(),
+                            "mutate", source, component, "merged:" + source.getId(),
+                            component == source ? "top" : "component", order++, first);
+                }
+            }
+
+            final Card melded = source.getMeldedWith();
+            if (melded != null && source.getId() < melded.getId()) {
+                first = appendRelationship(json, emitted, source.getId() + ":" + melded.getId(),
+                        "meld", source, melded, "meld:" + source.getId(), "pair", null, first);
+            }
+        }
+        json.append(']');
+    }
+
+    private boolean appendRelationship(final StringBuilder json, final Set<String> emitted,
+            final String suffix, final String kind, final Card source, final Card target,
+            final String groupId, final String role, final Integer order, final boolean first) {
+        final String id = kind + ":" + suffix;
+        if (!emitted.add(id)) return first;
+        if (!first) json.append(',');
+        json.append('{');
+        property(json, "relationshipId", id).append(',');
+        property(json, "kind", kind).append(',');
+        property(json, "sourceForgeObjectId", source.getId()).append(',');
+        property(json, "targetForgeObjectId", target.getId());
+        if (groupId != null) { json.append(','); property(json, "groupId", groupId); }
+        if (role != null) { json.append(','); property(json, "role", role); }
+        if (order != null) { json.append(','); property(json, "order", order.longValue()); }
+        json.append('}');
+        return false;
+    }
+
+    private void appendCombat(final StringBuilder json) {
+        final Combat combat = game.getCombat();
+        json.append("{\"attacks\":[");
+        // A game has no Combat object during startup and between combat phases.
+        // Snapshot emission must remain total: the empty combat state is authoritative.
+        if (combat == null) {
+            json.append("]}");
+            return;
+        }
+        boolean first = true;
+        for (Card attacker : combat.getAttackers()) {
+            if (!first) json.append(',');
+            first = false;
+            final GameEntity defender = combat.getDefenderByAttacker(attacker);
+            json.append('{');
+            property(json, "attackerForgeObjectId", attacker.getId()).append(',');
+            property(json, "defenderSeatId", defender instanceof Player player ? seatOf(player) : null).append(',');
+            if (defender instanceof Card card) {
+                property(json, "defenderForgeObjectId", (long) card.getId()).append(',');
+            } else {
+                property(json, "defenderForgeObjectId", (String) null).append(',');
+            }
+            json.append("\"blockerForgeObjectIds\":[");
+            boolean firstBlocker = true;
+            for (Card blocker : combat.getBlockers(attacker)) { if (!firstBlocker) json.append(','); firstBlocker = false; json.append(blocker.getId()); }
+            json.append("]}");
+        }
+        json.append("]}");
+    }
+
+    private static void appendCounters(final StringBuilder json, final Multiset<CounterType> counters) {
+        json.append('{');
+        boolean first = true;
+        for (Multiset.Entry<CounterType> entry : counters.entrySet()) {
+            if (!first) json.append(',');
+            first = false;
+            string(json, entry.getElement().getName());
+            json.append(':').append(entry.getCount());
+        }
+        json.append('}');
+    }
+
+    private static void appendManaPool(final StringBuilder json, final Player player) {
+        json.append('{');
+        property(json, "W", player.getManaPool().getAmountOfColor(MagicColor.WHITE)).append(',');
+        property(json, "U", player.getManaPool().getAmountOfColor(MagicColor.BLUE)).append(',');
+        property(json, "B", player.getManaPool().getAmountOfColor(MagicColor.BLACK)).append(',');
+        property(json, "R", player.getManaPool().getAmountOfColor(MagicColor.RED)).append(',');
+        property(json, "G", player.getManaPool().getAmountOfColor(MagicColor.GREEN)).append(',');
+        property(json, "C", player.getManaPool().getAmountOfColor(MagicColor.COLORLESS));
+        json.append('}');
+    }
+
+    private void appendGameEnded(final StringBuilder json) {
+        json.append('{');
+        property(json, "reason", game.getOutcome() == null ? null : game.getOutcome().getWinCondition().name()).append(',');
+        json.append("\"winnerSeatIds\":[");
+        boolean first = true;
+        for (Player player : game.getPlayers()) {
+            if (!player.hasWon()) continue;
+            if (!first) json.append(',');
+            first = false;
+            string(json, seatOf(player));
+        }
+        json.append("],\"loserSeatIds\":[");
+        first = true;
+        for (Player player : game.getPlayers()) {
+            if (!player.hasLost()) continue;
+            if (!first) json.append(',');
+            first = false;
+            string(json, seatOf(player));
+        }
+        json.append("]}");
+    }
+
+    private void appendDesignations(final StringBuilder json, final Player player) {
+        final Set<String> designations = new LinkedHashSet<>();
+        if (player.isMonarch()) designations.add("monarch");
+        if (player.hasInitiative()) designations.add("initiative");
+        if (player.hasBlessing()) designations.add("citys_blessing");
+        if (player.hasEnduringStory()) designations.add("enduring_story");
+        boolean first = true;
+        for (String designation : designations) {
+            if (!first) json.append(',');
+            first = false;
+            string(json, designation);
+        }
+    }
+
+    private static void appendCurrentTypes(final StringBuilder json, final CardTypeView type) {
+        final Set<String> types = new LinkedHashSet<>();
+        type.getSupertypes().forEach(value -> types.add(value.toString().toLowerCase(java.util.Locale.ROOT)));
+        type.getCoreTypes().forEach(value -> types.add(value.toString().toLowerCase(java.util.Locale.ROOT)));
+        type.getSubtypes().forEach(value -> types.add(value.toLowerCase(java.util.Locale.ROOT)));
+        json.append('[');
+        boolean first = true;
+        for (String value : types) {
+            if (!first) json.append(',');
+            first = false;
+            string(json, value);
+        }
+        json.append(']');
+    }
+
+    private String battlefieldSummary() {
+        if (!Boolean.getBoolean("forge.bridge.trace")) return "disabled";
+        final StringBuilder summary = new StringBuilder();
+        for (Player player : game.getPlayers()) {
+            for (Card card : player.getZone(ZoneType.Battlefield).getCards(false)) {
+                if (summary.length() > 0) summary.append(';');
+                summary.append(card.getName()).append('=')
+                        .append(card.isCreature() ? card.getNetPower() : 0).append('/')
+                        .append(card.isCreature() ? card.getNetToughness() : 0);
+            }
+        }
+        return summary.toString();
+    }
+
+    private static void trace(final String message) {
+        if (Boolean.getBoolean("forge.bridge.trace")) {
+            System.err.println("Forge bridge state " + message);
+        }
+    }
+
+    private String seatOf(final Player player) {
+        return player == null ? null : seats.get(player);
+    }
+
+    private static String zoneName(final ZoneType zoneType) {
+        return zoneType.name().toLowerCase(java.util.Locale.ROOT);
+    }
+
+    private static StringBuilder property(final StringBuilder json, final String name, final String value) {
+        string(json, name).append(':');
+        if (value == null) return json.append("null");
+        return string(json, value);
+    }
+
+    private static StringBuilder property(final StringBuilder json, final String name, final long value) {
+        return string(json, name).append(':').append(value);
+    }
+
+    private static StringBuilder property(final StringBuilder json, final String name, final boolean value) {
+        return string(json, name).append(':').append(value);
+    }
+
+    private static StringBuilder string(final StringBuilder json, final String value) {
+        json.append('"');
+        for (int i = 0; i < value.length(); i++) {
+            final char ch = value.charAt(i);
+            switch (ch) {
+                case '"' -> json.append("\\\"");
+                case '\\' -> json.append("\\\\");
+                case '\b' -> json.append("\\b");
+                case '\f' -> json.append("\\f");
+                case '\n' -> json.append("\\n");
+                case '\r' -> json.append("\\r");
+                case '\t' -> json.append("\\t");
+                default -> {
+                    if (ch < 0x20) json.append(String.format("\\u%04x", (int) ch));
+                    else json.append(ch);
+                }
+            }
+        }
+        return json.append('"');
+    }
+}
