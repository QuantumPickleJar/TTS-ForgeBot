+    private static int requiredTotalPower(CostTapType cost) {
+        String marker = "+withTotalPowerGE";
+        int markerIndex = cost.getType().indexOf(marker);
+        if (markerIndex < 0) return 0;
+        String suffix = cost.getType().substring(markerIndex + marker.length());
+        try {
+            return Integer.parseInt(suffix);
+        } catch (NumberFormatException ignored) {
+            return 0;
+        }
+    }
