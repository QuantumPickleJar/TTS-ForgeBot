+        BridgeStateFeed.emitControllerRevealViews(cards, zone, player, owner, messagePrefix, null, false, null);
+        super.reveal(cards, zone, owner, messagePrefix, addSuffix);
+    }
+
+    @Override
+    public ImmutablePair<CardCollection, CardCollection> arrangeForScry(CardCollection topN) {
+        BridgeStateFeed.emitControllerReveal(topN, ZoneType.Library, player, player, "Scry", "scry", true,
+                new String[] {"top", "bottom"});
+        return super.arrangeForScry(topN);
+    }
+
+    @Override
+    public ImmutablePair<CardCollection, CardCollection> arrangeForSurveil(CardCollection topN) {
+        BridgeStateFeed.emitControllerReveal(topN, ZoneType.Library, player, player, "Surveil", "surveil", true,
+                new String[] {"top", "graveyard"});
+        return super.arrangeForSurveil(topN);
+    }
+
+    @Override
+    public void orderAndPlaySimultaneousSa(List<SpellAbility> activePlayerSAs) {
+        // PlayerControllerAi.prepareSingleSa() delegates triggered targets to
+        // the AI brain.  That is the path that silently chose Banishing
+        // Light's ETB target before the bridge ever saw a decision.  Keep the
+        // inherited ordering and all non-target trigger behavior, but route
+        // every targeted human trigger through the same exact TUI candidate
+        // transport used by spell targeting.
+        for (SpellAbility sa : orderSimultaneousSa(activePlayerSAs)) {
+            if (sa.isTrigger() && !sa.isCopied() && sa.usesTargeting()) {
+                if (bridgePrepareTriggeredTargets(sa)) {
+                    forge.ai.ComputerUtil.playStack(sa, player, getGame());
+                }
+            } else {
+                super.orderAndPlaySimultaneousSa(Collections.singletonList(sa));
+            }
+        }
+    }
+
+    private boolean bridgePrepareTriggeredTargets(SpellAbility sa) {
+        if (sa.getActivatingPlayer() == null) sa.setActivatingPlayer(player);
+        if (sa.hasParam("TargetingPlayer")) {
+            FCollection<Player> candidates = new FCollection<>(
+                AbilityUtils.getDefinedPlayers(sa.getHostCard(), sa.getParam("TargetingPlayer"), sa));
+            Player targetingPlayer = chooseSingleEntityForEffect(candidates, sa,
+                "Choose the targeting player", false, null);
+            if (targetingPlayer == null) return false;
+            sa.setTargetingPlayer(targetingPlayer);
+        } else if (sa.getActivatingPlayer() != null) {
+            sa.setTargetingPlayer(sa.getActivatingPlayer());
+        }
+        return bridgeChooseTargetsFor(sa);
+    }
+
+    private boolean bridgeChooseTargetsFor(SpellAbility sa) {
+        if (!sa.usesTargeting() || sa.getTargetRestrictions() == null) return true;
+        final FCollection<GameEntity> candidates = new FCollection<>(
+            sa.getTargetRestrictions().getAllCandidates(sa));
+        final int min = sa.getMinTargets();
+        final int max = sa.getMaxTargets();
+        if (candidates.isEmpty()) return min == 0;
+        Card source = sa.getHostCard();
+        String sourceId = source == null ? "" : " sourceCardId=" + source.getId();
+        String sourceName = source == null ? "" : " sourceCardName=" + bridgeEncode(source.getName());
+        System.out.println("[bridge decisionCause=ability_targeting" + sourceId + sourceName
+            + " targetMin=" + min + " targetMax=" + max + "]");
+        List<GameEntity> selected = chooseEntitiesThroughTui("target_selection", candidates, min, max,
+            sa.getTargetRestrictions().getVTSelection(), false,
+            "decisionCause=ability_targeting sourceAbilityId=" + sa.getId());
+        if (selected == null || selected.size() < min || selected.size() > max) return false;
+        sa.clearTargets();
+        for (GameEntity entity : selected) sa.getTargets().add(entity);
+        return true;
+    }
 }
