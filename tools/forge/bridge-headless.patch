+        if (BRIDGE_SESSION_ID == null || BRIDGE_SESSION_ID.isBlank()) {
+            trace("decision_ready skipped: FORGEBOT_BRIDGE_SESSION_ID is not set");
+            return;
+        }
+        for (int attempt = 0; attempt < 40; attempt++) {
+            final long before = mutationGeneration.get();
+            emitWhenStable();
+            if (!snapshotScheduled.get() && mutationGeneration.get() == before) break;
+            try {
+                Thread.sleep(10);
+            } catch (InterruptedException exception) {
+                Thread.currentThread().interrupt();
+                return;
+            }
+        }
+
+        final long publishedSnapshotSequence = sequence; final StringBuilder json = new StringBuilder(256);
+        json.append('{');
+        property(json, "version", 1).append(',');
+        property(json, "type", "decision_ready").append(',');
+        property(json, "sessionId", BRIDGE_SESSION_ID).append(',');
+        property(json, "decisionGeneration", ++decisionGeneration).append(',');
+        property(json, "mutationGeneration", mutationGeneration.get()).append(',');
+        property(json, "snapshotSequence", publishedSnapshotSequence);
+        json.append('}');
+        synchronized (System.out) {
+            System.out.println(DECISION_READY_SENTINEL + json);
+            System.out.flush();
+        }
+        trace("decision_ready snapshotSequence=" + publishedSnapshotSequence + " mutationGeneration=" + mutationGeneration.get());
+    }
