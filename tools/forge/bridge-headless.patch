+    /**
+     * Roll back a cast whose source card has already entered the stack and
+     * publish the restoration as a normal Forge zone change.  The older
+     * rollbackAbility helper intentionally edits the zone directly because it
+     * is used for pre-commit targeting cancellation.  An interactive payment
+     * cancellation is a committed hand-to-stack attempt, so consumers must
+     * observe the corresponding stack-to-source-zone event.
+     */
+    public static Card rollbackAbilityAndEmitZoneChange(SpellAbility ability,
+            final Zone fromZone, final int zonePosition, CostPayment payment, Card oldCard) {
+        final Game game = ability.getActivatingPlayer().getGame();
+
+        if (game.restoreGameState()) {
+            System.out.println("Restored state from snapshot! Rolled back: "
+                    + ability.getHostCard().getName() + " - " + ability.getActivatingPlayer());
+            return game.getCardState(oldCard);
+        }
+
+        Card restored = oldCard;
+        if (fromZone != null && !fromZone.is(ZoneType.None)) {
+            // moveToStack replaces the source object with a same-ID stack
+            // object.  Move that authoritative object back so GameAction emits
+            // GameEventCardChangeZone(stack, sourceZone) and the snapshot/event
+            // producers see the same transition.
+            Card current = ability.getHostCard();
+            if (current == null || !current.isInZone(ZoneType.Stack)) {
+                current = oldCard;
+            }
+            restored = game.getAction().moveTo(fromZone.getZoneType(), current,
+                    zonePosition, null, null);
+            if (restored == null) {
+                return null;
+            }
+
+            restored.setCastSA(null);
+            restored.setCastFrom(null);
+            ability.setHostCard(restored);
+            ability.setXManaCostPaid(null);
+            ability.setSpendPhyrexianMana(false);
+            ability.clearPipsToReduce();
+            ability.setPaidLife(0);
+            if (ability.hasParam("Announce")) {
+                for (final String aVar : ability.getParam("Announce").split(",")) {
+                    final String varName = aVar.trim();
+                    if (!varName.equals("X")) {
+                        ability.setSVar(varName, "0");
+                    }
+                }
+            }
+            for (SpellAbility sa : restored.getSpells()) {
+                sa.setHostCard(restored);
+            }
+            ability.rollback();
+            restored.setBackSide(false);
+            restored.setState(restored.getFaceupCardStateName(), true);
+            restored.unanimateBestow();
+            if (ability.hasParam("Prototype")) {
+                restored.removeCloneState(restored.getPrototypeTimestamp());
+            }
+            for (Card c : ability.getTappedForConvoke()) {
+                c.setTapped(false);
+            }
+        }
+
+        if (ability.getApi() == ApiType.Charm) {
+            ability.setSubAbility(null);
+            ability.setChosenList(null);
+        }
+        ability.clearTargets();
+        ability.resetOnceResolved();
+        if (payment != null) {
+            payment.refundPayment();
+        }
+        game.getStack().clearFrozen();
+        game.getTriggerHandler().clearWaitingTriggers();
+        return restored;
+    }
+
 }
