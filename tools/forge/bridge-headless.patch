+        String kind = costPart.getClass().getSimpleName().toLowerCase().contains("sacrifice")
+            ? "sacrifice" : costPart.getClass().getSimpleName().toLowerCase().contains("discard")
+                ? "discard" : "cost_selection";
+        result.addAll(chooseEntitiesThroughTui(kind, optionList, isOptional ? 0 : amount,
