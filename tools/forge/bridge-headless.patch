+        for (KeywordInterface keyword : card == null ? java.util.Collections.<KeywordInterface>emptyList() : card.getKeywords()) {
+            final String name = keyword.getKeyword().toString();
+            if (!name.isEmpty()) keywords.add(name);
+        }
+        json.append('{');
+        property(json, "forgeCardId", card == null ? transition.forgeCardId : card.getId()).append(',');
+        property(json, "cardName", canonicalName).append(',');
