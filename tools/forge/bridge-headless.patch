+    private void appendLinkedExileRelationships(final StringBuilder json) {
+        boolean first = true;
+        final Set<String> seen = new HashSet<>();
+        for (Player player : game.getPlayers()) {
+            for (ZoneType zoneType : PLAYER_ZONES) {
+                for (Card card : player.getZone(zoneType).getCards(false)) {
+                    final Card source = card.getExiledWith();
+                    if (source == null || !source.isInZone(ZoneType.Battlefield)) continue;
+                    final String key = source.getId() + ":" + card.getId();
+                    if (!seen.add(key)) continue;
+                    if (!first) json.append(',');
+                    first = false;
+                    json.append('{');
+                    property(json, "sourceObjectId", "forge-object:" + source.getId()).append(',');
+                    property(json, "exiledObjectId", "forge-object:" + card.getId()).append(',');
+                    property(json, "relationshipKind", "linked_exile");
+                    json.append('}');
+                }
+            }
+        }
+    }
