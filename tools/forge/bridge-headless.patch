+        property(json, "phasedOut", phasedOut).append(',');
+        property(json, "netPower", netPower).append(',');
+        property(json, "netToughness", netToughness).append(',');
+        property(json, "currentPower", netPower).append(',');
+        property(json, "currentToughness", netToughness).append(',');
+        json.append("\"currentTypes\":");
