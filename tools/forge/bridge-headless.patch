+    private void appendStackObject(final StringBuilder json, final SpellAbilityStackInstance item,
+            final int stackIndex, final long creationSequence) {
+        final SpellAbility ability = item.getSpellAbility();
+        final Card source = item.getSourceCard();
+        final String kind = item.isTrigger() ? "triggered-ability"
+                : item.isSpell() ? (ability.isCopied() ? "copied-spell" : "spell")
+                : ability.isCopied() ? "copied-ability" : "activated-ability";
+        json.append('{');
+        property(json, "stackObjectId", "forge-stack:" + item.getId()).append(',');
+        property(json, "stackKind", kind).append(',');
+        property(json, "sourceCardInstanceId", source == null ? null : "forge-object:" + source.getId()).append(',');
+        property(json, "sourceName", source == null ? null : source.getName()).append(',');
+        property(json, "controllerSeatId", seatOf(item.getActivatingPlayer())).append(',');
+        property(json, "abilityName", ability == null ? null : ability.getDescription()).append(',');
+        property(json, "abilityText", item.getStackDescription()).append(',');
+        property(json, "creationSequence", creationSequence).append(',');
+        property(json, "stackIndex", stackIndex).append(',');
+        property(json, "provenance", ability != null && ability.isCopied() ? "copy" : kind).append(',');
+        json.append("\"targets\":[");
+        boolean firstTarget = true;
+        if (ability != null && ability.getTargets() != null) {
+            for (GameObject target : ability.getTargets()) {
+                if (!firstTarget) json.append(',');
+                firstTarget = false;
+                string(json, target instanceof Card
+                        ? "forge-object:" + ((Card) target).getId()
+                        : target instanceof Player ? seatOf((Player) target) : String.valueOf(target));
+            }
+        }
+        json.append("]}");
+    }
